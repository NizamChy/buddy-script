NODE_ENV=development
PORT=4000
# Pooled connection used at runtime (e.g. Neon "-pooler" host in production)
DATABASE_URL=postgresql://buddy:buddy@localhost:5434/buddy_script
# Direct connection used by `prisma migrate`
DATABASE_URL_UNPOOLED=postgresql://buddy:buddy@localhost:5434/buddy_script
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Browser origin(s) of the web app, comma separated
CORS_ORIGINS=http://localhost:3000
# Optional: store uploads in Vercel Blob instead of ./uploads
# BLOB_READ_WRITE_TOKEN=
# Set to true behind a reverse proxy (Vercel) so rate limiting sees the real client IP
# TRUST_PROXY=true
# Optional: Redis for the fan-out-on-write "Following" timeline cache (falls back to SQL without it)
REDIS_URL=redis://localhost:6380
# Authors with more followers than this are merged at read time instead of fanned out
# FANOUT_FOLLOWER_LIMIT=10000
# Background jobs (image processing, timeline fan-out): "background" runs them in-process after
# the response; "off" disables the in-process runner (defaults to off when NODE_ENV=test)
# JOBS_MODE=background
# Bearer secret for the cron-triggered job runner GET /api/internal/jobs/run (16+ chars)
# CRON_SECRET=
